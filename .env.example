# Infrastructure & Secrets
RAG_STORE_PROVIDER=postgres_store
RAG_DB_DSN=postgresql://postgres:postgres@localhost:5433/rag_db
GROQ_API_KEY=your_actual_groq_key_here

# Ingestion & Chunking Overrides
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_BOUNDARY_LOOKBACK_RATIO=0.6

# Retrieval & Reranking Overrides
RAG_ABSTENTION_THRESHOLD=0.2
RAG_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIM=384
RAG_RRF_K=60
RAG_SEMANTIC_WEIGHT=0.45
RAG_LEXICAL_WEIGHT=0.55
RAG_SECTION_BOOST=0.15

# Generation & Guardrails Overrides
RAG_LLM_MODEL=allam-2-7b
RAG_LLM_TEMP=0.1
RAG_LLM_MAX_TOKENS=1024
RAG_MIN_CITATION_OVERLAP=3